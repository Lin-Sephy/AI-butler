# 复制为 .env.local 并填值。.env.local 已 .gitignore，不会进仓库。
# Vite 只暴露 VITE_ 前缀的变量到前端代码。

# Supabase 项目（同后端 SUPABASE_URL）
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase 公开 key（publishable / anon）—— 可以在前端，配合 RLS 是安全的
# 注意：不要用 service key（后端才用）
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# 后端 API base URL
# - 开发期：连远端 Render（避开本机 VPN 卡 supabase.co 的问题）
# - 生产期：同上或换正式域名
VITE_API_BASE_URL=https://your-api.onrender.com
